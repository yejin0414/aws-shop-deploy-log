# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  cp .env.example .env
# .env 는 절대 깃허브에 올리지 마세요.

# python3 -c "import secrets; print(secrets.token_urlsafe(50))" 로 만든 값
DJANGO_SECRET_KEY=여기에_긴_랜덤_문자열
DEBUG=false

# EC2 퍼블릭 IP 또는 도메인 (쉼표로 여러 개)
ALLOWED_HOSTS=13.125.0.0
CSRF_TRUSTED_ORIGINS=http://13.125.0.0

# DB (EC2 안 MariaDB/MySQL)
DB_ENGINE=mysql
DB_NAME=ssingssing
DB_USER=shop
DB_PASSWORD=여기에_DB_비밀번호
DB_HOST=127.0.0.1
DB_PORT=3306

# 토스페이먼츠 > 개발자센터 > API 키 > "결제위젯 연동 키" (테스트 키)
TOSS_CLIENT_KEY=test_gck_여기에
TOSS_SECRET_KEY=test_gsk_여기에

# 상품 이미지를 S3에 저장하려면 true (EC2에 S3 권한 IAM 역할 필요)
USE_S3=false
AWS_STORAGE_BUCKET_NAME=내버킷이름
AWS_S3_REGION_NAME=ap-northeast-2

# 도메인 + HTTPS 적용 후 true
USE_HTTPS=false
