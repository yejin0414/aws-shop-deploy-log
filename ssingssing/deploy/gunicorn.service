[Unit]
Description=ssingssing market (gunicorn)
After=network.target mariadb.service

[Service]
User=ec2-user
Group=nginx
WorkingDirectory=/home/ec2-user/ssingssing
ExecStart=/home/ec2-user/ssingssing/venv/bin/gunicorn config.wsgi:application \
    --workers 2 --bind unix:/run/ssingssing/gunicorn.sock --umask 007 --timeout 60 \
    --access-logfile - --error-logfile -
RuntimeDirectory=ssingssing
RuntimeDirectoryMode=0750
Restart=always

[Install]
WantedBy=multi-user.target
